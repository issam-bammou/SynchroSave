<Window x:Class="SynchroSave.App.DetectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Détection des sauvegardes de jeux" Width="1000" Height="600" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" TextWrapping="Wrap"
                   Text="Dossiers de sauvegarde trouvés sur ce PC grâce à la base en ligne PCGamingWiki (~20 000 jeux, y compris Xbox Game Pass et les sauvegardes dans les dossiers d'installation Steam/Epic/GOG sur tous vos disques) et à l'analyse d'AppData, Documents, My Games et Saved Games. Cochez ceux à synchroniser vers OneDrive. Vous pouvez corriger le nom du jeu en double-cliquant dessus."/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="AddButton" Style="{StaticResource PrimaryButton}" Content="➕ Ajouter la sélection" IsDefault="True" Click="Add_Click"/>
                <Button Content="Fermer" IsCancel="True" Margin="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="☑ Tout cocher" Click="All_Click"/>
                <Button Content="☐ Tout décocher" Click="None_Click"/>
                <Button Content="📂 Ouvrir le dossier" Click="Open_Click"/>
            </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" x:Name="StatusText" FontWeight="SemiBold" Margin="0,0,0,8" Text="Analyse en cours… (peut prendre quelques secondes)"/>
        <DataGrid x:Name="Grid" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Ajouter" Width="65">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Jeu (modifiable)" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="200" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="Dossier" Binding="{Binding Path}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Trouvé par" Binding="{Binding Reason}" Width="210" IsReadOnly="True"/>
                <DataGridTextColumn Header="Fichiers" Binding="{Binding FileCount}" Width="60" IsReadOnly="True"/>
                <DataGridTextColumn Header="Taille" Binding="{Binding SizeText}" Width="75" IsReadOnly="True"/>
                <DataGridTextColumn Header="Modifié le" Binding="{Binding LastWriteText}" Width="115" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
